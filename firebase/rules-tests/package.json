{
  "name": "constanza-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas de comportamiento de las Security Rules de Firestore de Constanza contra el emulador.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project constanza-dev --config ../../firebase.json \"node firestore.rules.test.cjs\"",
    "test:no-emulator": "node firestore.rules.test.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
