rules_version = '2';

// =============================================================================
// Constanza — Security Rules de Firestore
//
// Principios (decisiones aprobadas, ver documentation/):
//   1. Todo el modelo vive bajo users/{uid}. Un usuario solo accede a lo suyo
//      y únicamente con el email verificado.
//   2. Los REGISTROS de cumplimiento son la fuente de verdad. Los documentos
//      canónicos (users, ambitos, habitos) NO contienen campos derivados.
//      Lo derivado vive aislado en users/{uid}/cache/rachas, que la app trata
//      como caché reconstruible y que NUNCA decide nada. Cuando existan Cloud
//      Functions, basta con cerrar la escritura de ese documento al cliente.
//   2b. Solo existe la RACHA GENERAL del usuario: no hay rachas por hábito ni
//      por ámbito, ni descansos, ni tareas de recuperación. El único mecanismo
//      para proteger la racha es el COMODÍN.
//   2c. El saldo de comodines (users/{uid}/comodines/saldo) y los días
//      protegidos (users/{uid}/diasProtegidos/{dia}) SÍ son fuente de verdad,
//      no caché: son entitlements con relación futura con anuncios y pagos.
//      Estas reglas validan cada transición, no solo la forma.
//   3. El cliente no puede escribir la suscripción ni alterar createdAt/email.
//   4. Los hábitos se borran en soft delete (deletedAt); nunca hard delete,
//      así el histórico de registros se conserva para estadísticas.
//   5. El ámbito "general" no se puede borrar: es el destino de los hábitos
//      cuando se elimina otro ámbito.
//
// LIMITACIÓN CONOCIDA — leer antes de tocar nada:
//   Las Rules NO tienen base de datos de zonas horarias IANA, así que NO
//   pueden comprobar "hoy según la zona del perfil". Solo pueden acotar la
//   fecha a una ventana derivada de request.time. Un cliente manipulado puede
//   retrodatar un registro aproximadamente 1 día. La restricción estricta
//   exige trusted backend (Cloud Functions). Es DEUDA TÉCNICA a resolver
//   antes de introducir nada con impacto económico o competitivo.
//   Ver documentation/PHASE5_STREAK_ENGINE.md §8.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------- helpers
    // VERIFICACIÓN DE EMAIL DESACTIVADA (ver lib/env.dart).
    // Los enlaces de verificación de Firebase llegan rotos en este proyecto,
    // así que de momento basta con estar autenticado. Para reactivarla,
    // descomentar la línea de email_verified Y poner
    // Env.requireEmailVerification = true en la app. Las dos cosas.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid;
        // && request.auth.token.email_verified == true;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Un campo escrito con FieldValue.serverTimestamp() vale request.time.
    function isServerTime(value) { return value == request.time; }
    function unchanged(field) { return incoming()[field] == existing()[field]; }

    function isShortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }
    function isNonNegInt(value) { return value is int && value >= 0; }
    function isColor(value) { return value is int && value >= 0 && value <= 4294967295; }
    function isNullOrTimestamp(value) { return value == null || value is timestamp; }

    // Día lógico en formato YYYY-MM-DD (string, independiente de zona horaria).
    function isDia(value) {
      return value is string
        && value.matches('^20[2-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // Ventana en la que un día lógico puede ser "hoy" para ALGÚN usuario.
    //
    // El día legítimo es date(request.time + offset) con offset entre -12h y
    // +14h (rango real de zonas IANA). Sin poder resolver la zona del perfil,
    // la cota más estrecha demostrable es:
    //     request.time - 36h  <=  dia  <=  request.time + 14h
    // Eso bloquea las fechas futuras y las claramente pasadas, pero deja un
    // margen de aproximadamente 1 día: NO es "solo hoy". Ver LIMITACIÓN
    // CONOCIDA arriba. El "solo hoy" exacto lo aplican el dominio y el cliente.
    function diaAsTimestamp(value) {
      return timestamp.date(int(value[0:4]), int(value[5:7]), int(value[8:10]));
    }
    function isDiaEnVentanaDeHoy(value) {
      return diaAsTimestamp(value) >= request.time - duration.value(36, 'h')
        && diaAsTimestamp(value) <= request.time + duration.value(14, 'h');
    }
    // Ventana del comodín: solo se puede proteger el día ANTERIOR a hoy, así
    // que se desplaza 24h respecto a la anterior:
    //     request.time - 60h  <=  dia  <=  request.time - 10h
    function isDiaEnVentanaDeRescate(value) {
      return diaAsTimestamp(value) >= request.time - duration.value(60, 'h')
        && diaAsTimestamp(value) <= request.time - duration.value(10, 'h');
    }
    // Mes actual del servidor como entero monótono (año*12 + mes). Es la
    // unidad de la concesión mensual de comodines.
    function mesActual() {
      return request.time.year() * 12 + request.time.month();
    }
    // Promoción temporal. Cambiar a false para recuperar los bloqueos
    // Premium junto con Env.premiumFeaturesFree y PREMIUM_FEATURES_FREE.
    function premiumFeaturesFree() {
      return true;
    }
    // Premium vigente según el perfil (lo escribe solo el backend a partir
    // de RevenueCat). La fecha de caducidad protege frente a un webhook
    // perdido. Cuesta una lectura: evaluarla siempre al FINAL de un `||`.
    function isPremiumUser(uid) {
      let sub = get(/databases/$(database)/documents/users/$(uid)).data.subscription;
      return premiumFeaturesFree() || (sub.status in ['active', 'premium']
        && (!('expiresAt' in sub) || sub.expiresAt == null
            || sub.expiresAt > request.time));
    }
    function subscriptionIsPremium(sub) {
      return premiumFeaturesFree() || (sub.status in ['active', 'premium']
        && (!('expiresAt' in sub) || sub.expiresAt == null
            || sub.expiresAt > request.time));
    }

    function isHora(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isTipoPeriodo(value) {
      return value in ['daily', 'weekly', 'monthly', 'yearly'];
    }
    // Periodicidad flexible: {tipo, veces}. Sin selección de días concretos.
    function isPeriodicidad(value) {
      return value is map
        && value.keys().hasOnly(['tipo', 'veces'])
        && value.keys().hasAll(['tipo', 'veces'])
        && isTipoPeriodo(value.tipo)
        && value.veces is int && value.veces >= 1 && value.veces <= 366;
    }
    function isCambioPeriodicidad(value) {
      return value is map
        && value.keys().hasOnly(['tipo', 'veces', 'desde'])
        && value.keys().hasAll(['tipo', 'veces', 'desde'])
        && isTipoPeriodo(value.tipo)
        && value.veces is int && value.veces >= 1 && value.veces <= 366
        && isDia(value.desde);
    }
    // Frases de motivación: como las reglas no pueden recorrer listas, se
    // valida cada posición posible (el tope es 20).
    function isMensajeEn(list, i) {
      return list.size() <= i || isShortText(list[i], 160);
    }
    function sonMensajesValidos(list) {
      return isMensajeEn(list, 0) && isMensajeEn(list, 1) && isMensajeEn(list, 2)
        && isMensajeEn(list, 3) && isMensajeEn(list, 4) && isMensajeEn(list, 5)
        && isMensajeEn(list, 6) && isMensajeEn(list, 7) && isMensajeEn(list, 8)
        && isMensajeEn(list, 9) && isMensajeEn(list, 10) && isMensajeEn(list, 11)
        && isMensajeEn(list, 12) && isMensajeEn(list, 13) && isMensajeEn(list, 14)
        && isMensajeEn(list, 15) && isMensajeEn(list, 16) && isMensajeEn(list, 17)
        && isMensajeEn(list, 18) && isMensajeEn(list, 19);
    }
    // Desde la fase 5 la app solo escribe 'completed'. Los documentos
    // antiguos con 'recovery'/'plannedRest' se conservan y se siguen leyendo,
    // pero no cuentan como actividad y no se pueden crear nuevos.
    function isTipoRegistro(value) {
      return value == 'completed';
    }

    // Ámbitos que la app siembra al crear la cuenta. Solo estos ids pueden
    // llevar esPredefinido = true.
    function isAmbitoPredefinido(ambitoId) {
      return ambitoId in ['general', 'salud', 'mente', 'desarrollo', 'energia'];
    }

    function ambitoPath(uid, ambitoId) {
      return /databases/$(database)/documents/users/$(uid)/ambitos/$(ambitoId);
    }
    function habitoPath(uid, habitoId) {
      return /databases/$(database)/documents/users/$(uid)/habitos/$(habitoId);
    }
    function saldoPath(uid) {
      return /databases/$(database)/documents/users/$(uid)/comodines/saldo;
    }
    function diaProtegidoPath(uid, dia) {
      return /databases/$(database)/documents/users/$(uid)/diasProtegidos/$(dia);
    }

    // ------------------------------------------------------------ users/{uid}
    // Perfil del usuario. Sin campos derivados.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && validUser(incoming())
        && incoming().email == request.auth.token.email
        && incoming().themeMode == 'light'
        && incoming().subscription == {'status': 'free'}
        && isServerTime(incoming().createdAt)
        && isServerTime(incoming().updatedAt)
        && (!('lastActiveAt' in incoming()) || isServerTime(incoming().lastActiveAt));

      allow update: if isOwner(uid)
        && validUser(incoming())
        && unchanged('email')
        && unchanged('createdAt')
        // La suscripción solo la cambia el backend (Admin SDK / Functions).
        && unchanged('subscription')
        && isServerTime(incoming().updatedAt)
        && (!('lastActiveAt' in incoming())
            || isServerTime(incoming().lastActiveAt)
            || ('lastActiveAt' in existing() && unchanged('lastActiveAt')));

      // El borrado de cuenta (cascada completa) se hace en servidor.
      allow delete: if false;

      function validUser(d) {
        return d.keys().hasOnly([
            'email', 'displayName', 'avatarId', 'timezone', 'timezoneAutomatic',
            'welcomeAnimationEnabled',
            'customMotivationMessages',
            'themeMode',
            'locale', 'subscription',
            'onboardingCompleted', 'createdAt', 'updatedAt', 'lastActiveAt'
          ])
          && d.keys().hasAll(['email', 'timezone', 'locale', 'subscription', 'createdAt', 'updatedAt'])
          && d.email is string
          && (!('displayName' in d) || d.displayName == null || isShortText(d.displayName, 40))
          && (!('avatarId' in d) || d.avatarId in [
            'traveler', 'friendly', 'magic', 'gamer', 'zen', 'night',
            'adventurer', 'legendary', 'hazel', 'cookie'
          ])
          && isShortText(d.timezone, 64)
          && (!('timezoneAutomatic' in d) || d.timezoneAutomatic is bool)
          && (!('welcomeAnimationEnabled' in d) || d.welcomeAnimationEnabled is bool)
          // `system` solo se tolera para no bloquear perfiles anteriores a
          // la preferencia binaria; los clientes actuales lo migran a light.
          && (!('themeMode' in d) || d.themeMode in ['system', 'light', 'dark'])
          && (!('customMotivationMessages' in d) || (
            d.customMotivationMessages is list
            && d.customMotivationMessages.size() <= 20
            && sonMensajesValidos(d.customMotivationMessages)
            && (
              subscriptionIsPremium(d.subscription)
              || d.customMotivationMessages.size() <= 1
              || (
                'customMotivationMessages' in existing()
                && existing().customMotivationMessages is list
                && d.customMotivationMessages.size()
                    <= existing().customMotivationMessages.size()
              )
            )
          ))
          && d.locale in ['es', 'en']
          && d.subscription is map
          && (!('onboardingCompleted' in d) || d.onboardingCompleted is bool);
      }
    }

    // ------------------------------------------------- users/{uid}/ambitos/{id}
    // Configuración de ámbitos. Sin rachas ni comodines (van en cache/rachas).
    match /users/{uid}/ambitos/{ambitoId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validAmbito(incoming())
        && isServerTime(incoming().createdAt)
        && isServerTime(incoming().updatedAt);

      allow update: if isOwner(uid)
        && validAmbito(incoming())
        && unchanged('createdAt')
        && unchanged('esPredefinido')
        && isServerTime(incoming().updatedAt);

      // "general" es el ámbito de reasignación y no puede eliminarse. La app
      // reasigna los hábitos del ámbito borrado a "general" en el mismo batch.
      allow delete: if isOwner(uid) && ambitoId != 'general';

      function validAmbito(d) {
        return d.keys().hasOnly(['nombre', 'emoji', 'colorValue', 'esPredefinido', 'orden', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['nombre', 'emoji', 'colorValue', 'esPredefinido', 'orden', 'createdAt', 'updatedAt'])
          && isShortText(d.nombre, 40)
          && isShortText(d.emoji, 16)
          && isColor(d.colorValue)
          && d.esPredefinido == isAmbitoPredefinido(ambitoId)
          && isNonNegInt(d.orden);
      }
    }

    // ----------------------------------------------- users/{uid}/peso/{docId}
    // Mediciones personales y objetivo. No intervienen en hábitos ni rachas.
    match /users/{uid}/peso/{docId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && ((docId == 'config' && validWeightConfig(incoming()))
          || (docId != 'config' && validWeightEntry(incoming())));

      allow update: if isOwner(uid)
        && docId == 'config'
        && validWeightConfig(incoming());

      // Todos los datos de salud pertenecen al usuario: puede borrar tanto
      // mediciones individuales como la configuración completa para empezar
      // desde cero (derecho de rectificación y supresión).
      allow delete: if isOwner(uid);

      function validWeightConfig(d) {
        return d.keys().hasOnly([
            'tipo', 'objetivoKg', 'pesoActualKg', 'edad', 'alturaCm',
            'sexoCalculo', 'nivelActividad', 'tipoObjetivo',
            'caloriasEstimadas', 'onboardingCompleted', 'consentimientoSalud',
            'updatedAt'
          ])
          && (!('consentimientoSalud' in d) || d.consentimientoSalud is bool)
          && d.keys().hasAll(['tipo', 'objetivoKg', 'updatedAt'])
          && d.tipo == 'config'
          && d.objetivoKg is number
          && d.objetivoKg >= 20 && d.objetivoKg <= 400
          && (!('onboardingCompleted' in d) || (
            d.onboardingCompleted == true
            && d.keys().hasAll([
              'pesoActualKg', 'edad', 'alturaCm', 'sexoCalculo',
              'nivelActividad', 'tipoObjetivo', 'caloriasEstimadas'
            ])
            && d.pesoActualKg is number
            && d.pesoActualKg >= 20 && d.pesoActualKg <= 400
            && d.edad is int && d.edad >= 18 && d.edad <= 100
            && d.alturaCm is number && d.alturaCm >= 120 && d.alturaCm <= 230
            && d.sexoCalculo in ['female', 'male', 'unspecified']
            && d.nivelActividad in ['sedentary', 'light', 'moderate', 'active', 'veryActive']
            && d.tipoObjetivo in ['lose', 'maintain', 'gain']
            && d.caloriasEstimadas is int
            && d.caloriasEstimadas >= 1200 && d.caloriasEstimadas <= 4500
          ))
          && isServerTime(d.updatedAt);
      }

      function validWeightEntry(d) {
        return d.keys().hasOnly(['tipo', 'pesoKg', 'recordedAt', 'createdAt'])
          && d.keys().hasAll(['tipo', 'pesoKg', 'recordedAt', 'createdAt'])
          && d.tipo == 'medicion'
          && d.pesoKg is number
          && d.pesoKg >= 20 && d.pesoKg <= 400
          && d.recordedAt is timestamp
          // Margen de 5 minutos: un reloj del dispositivo algo adelantado no
          // debe impedir registrar el peso.
          && d.recordedAt <= request.time + duration.value(5, 'm')
          && d.recordedAt >= request.time - duration.value(3660, 'd')
          && isServerTime(d.createdAt);
      }
    }

    // ------------------------------------------------- users/{uid}/habitos/{id}
    // Configuración de hábitos. Sin rachas. Soft delete vía deletedAt.
    match /users/{uid}/habitos/{habitoId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validHabito(incoming())
        && incoming().deletedAt == null
        // Mensaje propio del recordatorio: Premium.
        && (!('recordatorioMensaje' in incoming())
            || incoming().recordatorioMensaje == null
            || isPremiumUser(uid))
        && isServerTime(incoming().createdAt)
        && isServerTime(incoming().updatedAt)
        && exists(ambitoPath(uid, incoming().ambitoId));

      allow update: if isOwner(uid)
        && validHabito(incoming())
        && unchanged('createdAt')
        && (!('recordatorioMensaje' in incoming())
            || incoming().recordatorioMensaje == null
            || ('recordatorioMensaje' in existing()
                && unchanged('recordatorioMensaje'))
            || isPremiumUser(uid))
        && isServerTime(incoming().updatedAt)
        && (unchanged('ambitoId') || exists(ambitoPath(uid, incoming().ambitoId)))
        // deletedAt solo puede quedarse igual, ponerse a null (restaurar) o
        // fijarse al instante del servidor (soft delete).
        && (unchanged('deletedAt')
            || incoming().deletedAt == null
            || isServerTime(incoming().deletedAt));

      // Nunca hard delete: los registros históricos deben conservarse.
      allow delete: if false;

      // Campos legacy (descansos, recuperación, historialPeriodicidad con el
      // nombre antiguo): TOLERADOS en hasOnly pero NO exigidos en hasAll.
      //
      // No se pueden quitar de hasOnly todavía: en Firestore un update se
      // valida contra el documento resultante COMPLETO, así que un hábito
      // creado antes de la fase 5 dejaría de poder editarse aunque no se
      // tocasen esos campos. El cliente los borra con FieldValue.delete() en
      // cada escritura, de modo que cada hábito se migra solo la primera vez
      // que se edita. Cuando no quede ninguno, se retiran de esta lista.
      function validHabito(d) {
        return d.keys().hasOnly([
            'nombre', 'emoji', 'colorValue', 'ambitoId', 'periodicidad',
            'cambiosPeriodicidad', 'recordatorioHora', 'recordatorioMensaje', 'orden', 'deletedAt',
            'trackingType', 'targetCount', 'unit', 'displayGoal', 'iconId', 'progressIconId',
            'habitKind', 'abstinenceStartedAt', 'bestAbstinenceSeconds', 'relapseCount',
            'createdAt', 'updatedAt',
            // legacy, solo tolerados
            'historialPeriodicidad', 'descansosPermitidos',
            'tareaRecuperacion', 'recuperacionCooldownDias'
          ])
          && d.keys().hasAll([
            'nombre', 'emoji', 'colorValue', 'ambitoId', 'periodicidad',
            'cambiosPeriodicidad', 'orden', 'deletedAt', 'createdAt', 'updatedAt'
          ])
          && isShortText(d.nombre, 60)
          && isShortText(d.emoji, 16)
          && (!('iconId' in d) || isShortText(d.iconId, 32))
          && isColor(d.colorValue)
          && isShortText(d.ambitoId, 128)
          && isPeriodicidad(d.periodicidad)
          && d.cambiosPeriodicidad is list
          // Cada cambio real añade una entrada (los pendientes se sustituyen),
          // así que 400 es holgado; el tope evita documentos gigantes.
          && d.cambiosPeriodicidad.size() <= 400
          // La app siempre añade al final: se valida la última entrada.
          && (d.cambiosPeriodicidad.size() == 0
              || isCambioPeriodicidad(
                d.cambiosPeriodicidad[d.cambiosPeriodicidad.size() - 1]))
          && (!('recordatorioHora' in d) || d.recordatorioHora == null || isHora(d.recordatorioHora))
          && (!('recordatorioMensaje' in d) || d.recordatorioMensaje == null || isShortText(d.recordatorioMensaje, 120))
          && (!('trackingType' in d) || d.trackingType in ['single', 'repetitions'])
          && (!('targetCount' in d) || (d.targetCount is int && d.targetCount >= 1 && d.targetCount <= 999))
          && (!('unit' in d) || d.unit == null || isShortText(d.unit, 24))
          && (!('displayGoal' in d) || d.displayGoal == null || isShortText(d.displayGoal, 32))
          && (!('progressIconId' in d) || isShortText(d.progressIconId, 32))
          && (!('habitKind' in d) || d.habitKind in ['build', 'quit'])
          && (!('abstinenceStartedAt' in d) || isNullOrTimestamp(d.abstinenceStartedAt))
          && (!('abstinenceStartedAt' in d) || d.abstinenceStartedAt == null
              || d.abstinenceStartedAt <= request.time + duration.value(5, 'm'))
          && (!('habitKind' in d) || d.habitKind != 'quit'
              || (d.abstinenceStartedAt is timestamp))
          && (!('bestAbstinenceSeconds' in d) || isNonNegInt(d.bestAbstinenceSeconds))
          && (!('relapseCount' in d) || isNonNegInt(d.relapseCount))
          && isNonNegInt(d.orden)
          && isNullOrTimestamp(d.deletedAt);
      }
    }

    // ----------------------------------------------- users/{uid}/registros/{id}
    // FUENTE DE VERDAD. Id determinista "{habitoId}_{YYYY-MM-DD}": marcar es
    // set, desmarcar es delete, sin duplicados y sin consultas previas.
    match /users/{uid}/registros/{registroId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validRegistro(incoming())
        && registroId == incoming().habitoId + '_' + incoming().dia
        && isDiaEnVentanaDeHoy(incoming().dia)
        && isServerTime(incoming().createdAt)
        && habitoActivo(incoming().habitoId);

      // Solo el contador del día actual puede avanzar o retroceder. La fecha,
      // el hábito y el objetivo histórico permanecen inmutables.
      allow update: if isOwner(uid)
        && validRegistro(incoming())
        && unchanged('habitoId') && unchanged('dia') && unchanged('tipo')
        && unchanged('targetCount')
        && isDiaEnVentanaDeHoy(incoming().dia)
        && habitoActivo(incoming().habitoId)
        && habitoData(incoming().habitoId).trackingType == 'repetitions';

      // Los registros de un hábito eliminado (soft delete) son inmutables:
      // borrar un hábito hoy no debe reescribir la racha histórica (§30).
      allow delete: if isOwner(uid) && habitoActivo(existing().habitoId);

      function habitoData(habitoId) { return get(habitoPath(uid, habitoId)).data; }
      function habitoActivo(habitoId) {
        return exists(habitoPath(uid, habitoId)) && habitoData(habitoId).deletedAt == null;
      }

      function validRegistro(d) {
        return d.keys().hasOnly(['habitoId', 'dia', 'tipo', 'tz', 'createdAt', 'completedCount', 'targetCount'])
          && d.keys().hasAll(['habitoId', 'dia', 'tipo', 'createdAt'])
          && isShortText(d.habitoId, 128)
          && isDia(d.dia)
          && isTipoRegistro(d.tipo)
          && (!('completedCount' in d) || (d.completedCount is int && d.completedCount >= 1 && d.completedCount <= 999))
          && (!('targetCount' in d) || (d.targetCount is int && d.targetCount >= 1 && d.targetCount <= 999 && d.completedCount <= d.targetCount))
          && (!('tz' in d) || isShortText(d.tz, 64));
      }
    }

    // -------------------------------------- users/{uid}/diasProtegidos/{dia}
    // Días sin actividad cuya continuidad protege un comodín.
    //
    // El id del documento ES el día (YYYY-MM-DD), así que proteger dos veces
    // el mismo día es estructuralmente imposible: `create` solo aplica si el
    // documento no existe.
    //
    // Un día protegido NO crea un registro falso, no marca ningún hábito y no
    // rellena calendarios: solo mantiene la cadena, y nunca suma un día.
    match /users/{uid}/diasProtegidos/{dia} {
      allow read: if isOwner(uid);

      // ATOMICIDAD: este create solo se permite dentro de la misma
      // transacción/batch que decrementa el saldo. getAfter() mira el estado
      // del saldo DESPUÉS de aplicarse toda la operación, así que no hay
      // forma de proteger un día sin pagarlo.
      allow create: if isOwner(uid)
        && validDiaProtegido(incoming())
        && incoming().dia == dia
        && isDiaEnVentanaDeRescate(dia)
        && isServerTime(incoming().createdAt)
        && exists(saldoPath(uid))
        && getAfter(saldoPath(uid)).data.saldo == get(saldoPath(uid)).data.saldo - 1
        && getAfter(saldoPath(uid)).data.ultimoDiaProtegido == dia;

      // Inmutable y no borrable: el historial de días protegidos tiene que
      // poder auditarse y reconstruirse (§26).
      allow update, delete: if false;

      function validDiaProtegido(d) {
        return d.keys().hasOnly(['dia', 'createdAt'])
          && d.keys().hasAll(['dia', 'createdAt'])
          && isDia(d.dia);
      }
    }

    // ------------------------------------------ users/{uid}/comodines/saldo
    // Saldo de comodines. FUENTE DE VERDAD, no caché.
    //
    // Solo se admiten DOS transiciones desde el cliente:
    //   1. concesión mensual gratuita, validada contra el reloj del servidor;
    //   2. consumo de 1, atado a la creación de un día protegido.
    // Cualquier otra mutación se deniega. Los orígenes futuros (anuncio
    // recompensado, compra, Premium) NO pueden pasar por aquí: requieren
    // verificación en servidor y entrarán por Admin SDK, que salta las Rules.
    match /users/{uid}/comodines/{docId} {
      allow read: if isOwner(uid);

      // Arranque: 1 comodín, el del mes en curso. Solo se puede crear una
      // vez porque el delete está prohibido: no hay forma de farmear saldo
      // borrando y recreando el documento.
      allow create: if isOwner(uid)
        && docId == 'saldo'
        && validSaldo(incoming())
        && incoming().saldo == 1
        && incoming().ultimaConcesionYM == mesActual()
        && incoming().concedidosTotal == 1
        && incoming().ultimoDiaProtegido == null
        && isServerTime(incoming().updatedAt);

      allow update: if isOwner(uid)
        && docId == 'saldo'
        && validSaldo(incoming())
        && isServerTime(incoming().updatedAt)
        && (esConcesionMensual() || esConsumo(uid));

      allow delete: if false;

      // Concede +1 por mes transcurrido, con tope 3.
      //
      // Idempotente por construcción: ultimaConcesionYM es estrictamente
      // monótono y obligado a ser el mes ACTUAL del servidor, así que no se
      // puede conceder dos veces en el mismo mes ni adelantar meses futuros.
      // Un usuario que no abre la app durante tres meses recupera lo que le
      // tocaba sin pasar de 3.
      function esConcesionMensual() {
        return incoming().ultimaConcesionYM == mesActual()
          && existing().ultimaConcesionYM < mesActual()
          && incoming().saldo == saldoTrasConcesion()
          && incoming().concedidosTotal
               == existing().concedidosTotal + (incoming().saldo - existing().saldo)
          && incoming().ultimoDiaProtegido == existing().ultimoDiaProtegido;
      }

      // Consumo de exactamente 1, atado al día protegido que lo justifica.
      //
      // El día tiene que NO existir antes y SÍ existir después: eso obliga a
      // que las dos escrituras viajen juntas y hace imposible decrementar el
      // saldo sin proteger nada, o reutilizar un día ya protegido.
      function esConsumo(uid) {
        return incoming().saldo == existing().saldo - 1
          && incoming().saldo >= 0
          && incoming().ultimaConcesionYM == existing().ultimaConcesionYM
          && incoming().concedidosTotal == existing().concedidosTotal
          && incoming().ultimoDiaProtegido is string
          && isDia(incoming().ultimoDiaProtegido)
          && isDiaEnVentanaDeRescate(incoming().ultimoDiaProtegido)
          && !exists(diaProtegidoPath(uid, incoming().ultimoDiaProtegido))
          && getAfter(diaProtegidoPath(uid, incoming().ultimoDiaProtegido)).data.dia
               == incoming().ultimoDiaProtegido;
      }

      // Saldo tras aplicar los meses transcurridos, con tope 3.
      // (las Rules de Firestore no tienen math.min, de ahí el ternario)
      function totalTrasConcesion() {
        return existing().saldo + (mesActual() - existing().ultimaConcesionYM);
      }
      function saldoTrasConcesion() {
        return totalTrasConcesion() > 3 ? 3 : totalTrasConcesion();
      }

      function validSaldo(d) {
        return d.keys().hasOnly(['saldo', 'ultimaConcesionYM', 'concedidosTotal', 'ultimoDiaProtegido', 'updatedAt'])
          && d.keys().hasAll(['saldo', 'ultimaConcesionYM', 'concedidosTotal', 'updatedAt'])
          && d.saldo is int && d.saldo >= 0 && d.saldo <= 3
          && d.ultimaConcesionYM is int && d.ultimaConcesionYM > 0
          && isNonNegInt(d.concedidosTotal)
          && (!('ultimoDiaProtegido' in d)
              || d.ultimoDiaProtegido == null
              || isDia(d.ultimoDiaProtegido));
      }
    }

    // ------------------------------------------ users/{uid}/tareas/{taskId}
    // Herramienta Tareas (sección Herramientas). No interviene en hábitos ni
    // en rachas: ninguna herramienta escribe en registros. Se admiten fechas
    // pasadas y futuras porque no hay racha que falsear.
    match /users/{uid}/tareas/{taskId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validTask(incoming())
        && isServerTime(incoming().createdAt);

      allow update: if isOwner(uid)
        && validTask(incoming())
        && unchanged('createdAt');

      allow delete: if isOwner(uid);

      function validTask(d) {
        return d.keys().hasOnly([
            'titulo', 'nota', 'fecha', 'hora', 'prioridad', 'orden',
            'completadaEn', 'arrastradaDesde', 'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll([
            'titulo', 'nota', 'fecha', 'hora', 'prioridad', 'orden',
            'completadaEn', 'arrastradaDesde', 'createdAt', 'updatedAt'
          ])
          && isShortText(d.titulo, 120)
          && (d.nota == null || (d.nota is string && d.nota.size() <= 500))
          && (d.fecha == null || isDia(d.fecha))
          // La hora solo tiene sentido con fecha.
          && (d.hora == null || (d.fecha != null && isHora(d.hora)))
          && d.prioridad in ['low', 'normal', 'high']
          && isNonNegInt(d.orden)
          && isNullOrTimestamp(d.completadaEn)
          && (d.arrastradaDesde == null || isDia(d.arrastradaDesde))
          && d.createdAt is timestamp
          && isServerTime(d.updatedAt);
      }
    }

    // ---------------------------------------- users/{uid}/pomodoro/{docId}
    // Herramienta Pomodoro: `config` (ajustes) y `sesiones/items/{id}` (una
    // por fase de concentración completada). No toca hábitos ni rachas.
    match /users/{uid}/pomodoro/{docId} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && docId == 'config'
        && validPomodoroConfig(incoming());

      allow delete: if isOwner(uid) && docId == 'config';

      function validPomodoroConfig(d) {
        return d.keys().hasOnly([
            'trabajoMin', 'descansoCortoMin', 'descansoLargoMin',
            'pomodorosPorCiclo', 'autoDescanso', 'autoTrabajo', 'sonido',
            'vibracion', 'updatedAt'
          ])
          && d.keys().hasAll([
            'trabajoMin', 'descansoCortoMin', 'descansoLargoMin',
            'pomodorosPorCiclo', 'autoDescanso', 'autoTrabajo', 'sonido',
            'vibracion', 'updatedAt'
          ])
          && d.trabajoMin is int && d.trabajoMin >= 15 && d.trabajoMin <= 60
          && d.descansoCortoMin is int && d.descansoCortoMin >= 3 && d.descansoCortoMin <= 15
          && d.descansoLargoMin is int && d.descansoLargoMin >= 10 && d.descansoLargoMin <= 30
          && d.pomodorosPorCiclo is int && d.pomodorosPorCiclo >= 2 && d.pomodorosPorCiclo <= 6
          && d.autoDescanso is bool && d.autoTrabajo is bool
          && d.sonido is bool && d.vibracion is bool
          && isServerTime(d.updatedAt);
      }

      match /items/{sessionId} {
        allow read: if isOwner(uid) && docId == 'sesiones';

        // Una sesión no se edita: se crea al completar la fase y, como
        // mucho, se borra ("Borrar historial").
        allow create: if isOwner(uid)
          && docId == 'sesiones'
          && validPomodoroSession(incoming());

        allow update: if false;
        allow delete: if isOwner(uid) && docId == 'sesiones';

        function validPomodoroSession(d) {
          return d.keys().hasOnly(['dia', 'inicio', 'duracionMin', 'etiqueta', 'createdAt'])
            && d.keys().hasAll(['dia', 'inicio', 'duracionMin', 'etiqueta', 'createdAt'])
            && isDia(d.dia)
            && d.inicio is timestamp
            && d.inicio <= request.time + duration.value(5, 'm')
            && d.duracionMin is int && d.duracionMin >= 1 && d.duracionMin <= 60
            && d.etiqueta is string && d.etiqueta.size() <= 60
            && isServerTime(d.createdAt);
        }
      }
    }

    // ------------------------------- users/{uid}/listasCompra/{listaId}/items
    // Herramienta Lista de la compra. Solo personal (sin compartir). En v2
    // existe una única lista, `principal`; el documento de lista es opcional.
    match /users/{uid}/listasCompra/{listaId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validShoppingList(incoming());
      allow delete: if isOwner(uid);

      function validShoppingList(d) {
        return d.keys().hasOnly(['nombre', 'createdAt', 'updatedAt'])
          && isShortText(d.nombre, 60)
          && isServerTime(d.updatedAt);
      }

      match /items/{itemId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validShoppingItem(incoming())
          && isServerTime(incoming().createdAt);

        allow update: if isOwner(uid)
          && validShoppingItem(incoming())
          && unchanged('createdAt');

        allow delete: if isOwner(uid);

        function validShoppingItem(d) {
          return d.keys().hasOnly(['nombre', 'cantidad', 'nota', 'compradoEn', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['nombre', 'cantidad', 'nota', 'compradoEn', 'createdAt', 'updatedAt'])
            && isShortText(d.nombre, 80)
            && (d.cantidad == null || (d.cantidad is int && d.cantidad >= 1 && d.cantidad <= 999))
            && (d.nota == null || (d.nota is string && d.nota.size() <= 120))
            && isNullOrTimestamp(d.compradoEn)
            && d.createdAt is timestamp
            && isServerTime(d.updatedAt);
        }
      }
    }

    // -------------------------------------------- users/{uid}/finanzas/{docId}
    // Herramienta Finanzas. Un único nodo para exportar y borrar de una vez:
    //   config, movimientos/items, gastosFijos/items, inversiones/items y
    //   comprasPendientes/items. Importes en CÉNTIMOS ENTEROS; la moneda
    //   (ISO 4217) vive en config. No toca hábitos ni rachas.
    match /users/{uid}/finanzas/{docId} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && docId == 'config'
        && validFinanceConfig(incoming());

      allow delete: if isOwner(uid) && docId == 'config';

      function validFinanceConfig(d) {
        return d.keys().hasOnly(['moneda', 'diaInicioMes', 'updatedAt'])
          && d.keys().hasAll(['moneda', 'diaInicioMes', 'updatedAt'])
          && d.moneda is string && d.moneda.matches('^[A-Z]{3}$')
          && d.diaInicioMes is int && d.diaInicioMes >= 1 && d.diaInicioMes <= 28
          && isServerTime(d.updatedAt);
      }

      function isCents(value) {
        return value is int && value > 0 && value <= 100000000;
      }
      function isCentsOrZero(value) {
        return value is int && value >= 0 && value <= 100000000;
      }
      function isCategoria(value) {
        return value in ['home', 'food', 'transport', 'leisure', 'health', 'clothes',
          'subscriptions', 'gifts', 'salary', 'investment', 'other'];
      }
      function isNullOrId(value) {
        return value == null || (value is string && value.size() > 0 && value.size() <= 64);
      }

      match /items/{itemId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validItem(docId, incoming())
          && isServerTime(incoming().createdAt);

        allow update: if isOwner(uid)
          && validItem(docId, incoming())
          && unchanged('createdAt');

        allow delete: if isOwner(uid);

        function validItem(group, d) {
          return (group == 'movimientos' && validMovimiento(d))
            || (group == 'gastosFijos' && validGastoFijo(d))
            || (group == 'inversiones' && validInversion(d))
            || (group == 'comprasPendientes' && validCompraPendiente(d));
        }

        function validMovimiento(d) {
          return d.keys().hasOnly(['tipo', 'importeCents', 'concepto', 'categoria', 'fecha', 'nota',
              'gastoFijoId', 'inversionId', 'compraPendienteId', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['tipo', 'importeCents', 'concepto', 'categoria', 'fecha', 'nota',
              'gastoFijoId', 'inversionId', 'compraPendienteId', 'createdAt', 'updatedAt'])
            && d.tipo in ['gasto', 'ingreso']
            && isCents(d.importeCents)
            && isShortText(d.concepto, 80)
            && isCategoria(d.categoria)
            && isDia(d.fecha)
            && (d.nota == null || (d.nota is string && d.nota.size() <= 200))
            && isNullOrId(d.gastoFijoId) && isNullOrId(d.inversionId) && isNullOrId(d.compraPendienteId)
            && d.createdAt is timestamp
            && isServerTime(d.updatedAt);
        }

        function validGastoFijo(d) {
          return d.keys().hasOnly(['nombre', 'importeCents', 'diaDelMes', 'categoria', 'activo',
              'registradoMeses', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['nombre', 'importeCents', 'diaDelMes', 'categoria', 'activo',
              'registradoMeses', 'createdAt', 'updatedAt'])
            && isShortText(d.nombre, 80)
            && isCents(d.importeCents)
            && d.diaDelMes is int && d.diaDelMes >= 1 && d.diaDelMes <= 28
            && isCategoria(d.categoria)
            && d.activo is bool
            && d.registradoMeses is list && d.registradoMeses.size() <= 240
            && d.createdAt is timestamp
            && isServerTime(d.updatedAt);
        }

        function validInversion(d) {
          return d.keys().hasOnly(['nombre', 'tipo', 'aportadoCents', 'valorActualCents',
              'valorActualizadoEn', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['nombre', 'tipo', 'aportadoCents', 'valorActualCents',
              'valorActualizadoEn', 'createdAt', 'updatedAt'])
            && isShortText(d.nombre, 80)
            && d.tipo in ['funds', 'stocks', 'crypto', 'deposit', 'property', 'other']
            && isCentsOrZero(d.aportadoCents)
            && isCentsOrZero(d.valorActualCents)
            && d.valorActualizadoEn is timestamp
            && d.createdAt is timestamp
            && isServerTime(d.updatedAt);
        }

        function validCompraPendiente(d) {
          return d.keys().hasOnly(['nombre', 'importeEstimadoCents', 'prioridad', 'fechaObjetivo',
              'compradaEn', 'movimientoId', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['nombre', 'importeEstimadoCents', 'prioridad', 'fechaObjetivo',
              'compradaEn', 'movimientoId', 'createdAt', 'updatedAt'])
            && isShortText(d.nombre, 80)
            && isCents(d.importeEstimadoCents)
            && d.prioridad in ['low', 'normal', 'high']
            && (d.fechaObjetivo == null || isDia(d.fechaObjetivo))
            && isNullOrTimestamp(d.compradaEn)
            && isNullOrId(d.movimientoId)
            && d.createdAt is timestamp
            && isServerTime(d.updatedAt);
        }
      }
    }

    // ------------------------------------------- users/{uid}/pasos/{docId}
    // Herramienta Pasos: `config` (objetivo y consentimiento) y un documento
    // por día lógico con el total del contador nativo del dispositivo (Core
    // Motion / sensor de pasos). Es el histórico completo desde que se usa
    // Constanza. Son datos de salud: el usuario puede borrarlos cuando quiera.
    match /users/{uid}/pasos/{docId} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && ((docId == 'config' && validStepsConfig(incoming()))
          || (docId != 'config' && isDia(docId) && validStepsDay(incoming())));

      allow delete: if isOwner(uid);

      function validStepsConfig(d) {
        return d.keys().hasOnly(['objetivo', 'consentimientoSalud', 'updatedAt'])
          && d.keys().hasAll(['objetivo', 'consentimientoSalud', 'updatedAt'])
          && d.objetivo is int && d.objetivo >= 500 && d.objetivo <= 30000
          && d.consentimientoSalud is bool
          && isServerTime(d.updatedAt);
      }

      function validStepsDay(d) {
        return d.keys().hasOnly(['pasos', 'distanciaM', 'fuente', 'updatedAt'])
          && d.keys().hasAll(['pasos', 'distanciaM', 'fuente', 'updatedAt'])
          && d.pasos is int && d.pasos >= 0 && d.pasos <= 200000
          && (d.distanciaM == null || (d.distanciaM is int && d.distanciaM >= 0 && d.distanciaM <= 500000))
          && d.fuente in ['pedometer', 'healthkit', 'healthconnect']
          && isServerTime(d.updatedAt);
      }
    }

    // -------------------------------------------------- users/{uid}/cache/rachas
    // ÚNICO documento con datos derivados que el cliente puede escribir.
    //
    // Es una PROYECCIÓN reconstruible desde registros + días protegidos. Las
    // reglas validan forma y tipos, NO el valor: un cliente manipulado puede
    // escribir aquí una racha falsa.
    //
    // Eso es aceptable mientras la racha no desbloquee nada, y es un
    // invariante explícito del proyecto: si algún día la racha concede
    // recompensas, este cálculo TIENE que moverse a servidor (cambiar
    // create/update a "if false"). La app nunca lee de aquí para decidir:
    // calcula la racha en vivo desde los registros.
    match /users/{uid}/cache/{cacheId} {
      allow read: if isOwner(uid);

      allow create, update: if isOwner(uid)
        && cacheId == 'rachas'
        && validCacheRachas(incoming());

      allow delete: if isOwner(uid);

      function validCacheRachas(d) {
        return d.keys().hasOnly(['rachaActual', 'mejorRacha', 'ultimoDiaActividad', 'calculadoHasta', 'version', 'updatedAt'])
          && d.keys().hasAll(['rachaActual', 'mejorRacha', 'calculadoHasta', 'version', 'updatedAt'])
          && isNonNegInt(d.rachaActual)
          && isNonNegInt(d.mejorRacha)
          && (!('ultimoDiaActividad' in d)
              || d.ultimoDiaActividad == null
              || isDia(d.ultimoDiaActividad))
          && isDia(d.calculadoHasta)
          && d.version is int
          && isServerTime(d.updatedAt);
      }
    }
  }
}
